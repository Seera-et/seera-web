# Copy to .env.local for local development. .env.local is gitignored.
#
# Two variables, two different consumers:
#
#   API_PROXY_TARGET      read by vite.config.ts only (dev server, never bundled)
#   VITE_API_BASE_URL     read by the browser bundle
#
# The default of both is "the API on the host at :8081, reached same-origin
# through the Vite dev proxy", which is what `docker compose up` in
# seera-backend-services gives you. With those defaults `npm run dev` works
# with no .env.local at all.

# Where the Vite dev server forwards /api and /healthz.
# docker compose (api profile) publishes the Go API on host port 8081.
# Running the API on the host with `go run ./cmd/api` uses PORT (8080 by default).
API_PROXY_TARGET=http://localhost:8081

# Prefix the frontend puts in front of every request path.
# Empty = same origin, i.e. go through the dev proxy above. Set an absolute
# origin only when talking to the API directly (then the API's
# CORS_ALLOWED_ORIGINS must include http://localhost:5173).
VITE_API_BASE_URL=

# Supabase, for Google sign-in.
#
# Neither value is a secret. The publishable (anon) key is the project's
# anonymous identity and is designed to be served to every visitor — it is
# useless without a signed user token, and it is what the sign-in flow needs in
# the browser. Both are safe to set in Vercel, unlike VITE_ADMIN_API_TOKEN
# below.
#
# Copy them from the Supabase dashboard: Project Settings → API.
# When either is empty the app still runs: browsing the corpus works and the
# sign-in screen says it is not configured, rather than the page crashing.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional. Guards POST /api/v1/admin/documents/ingest. Leave empty unless you
# are using the ingest screen locally; anything in a VITE_ variable ships to the
# browser, so this is a local-development convenience, never a production value.
VITE_ADMIN_API_TOKEN=
